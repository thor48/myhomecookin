# Where the Next.js server can reach Mealie. Mealie does NOT need to be
# exposed to the internet — only this app does.
#   On Unraid with both containers on the same custom Docker network:
#     MEALIE_URL=http://mealie:9000
#   Or by LAN address:
#     MEALIE_URL=http://192.168.1.10:9925
MEALIE_URL=http://localhost:9000

# Name shown in the header and on the home-screen icon.
NEXT_PUBLIC_SITE_NAME="My Home Cookin'"
# Label under the home-screen icon (keep it to ~12 characters).
NEXT_PUBLIC_SITE_SHORT_NAME="Home Cookin'"

# Optional: turns on "Add from a photo" (recipe cards, cookbook pages).
# Create a key at https://platform.claude.com — each photo costs a few cents.
# Read at runtime, so you can add it to the container without rebuilding.
ANTHROPIC_API_KEY=
